# Copy to .env. Never commit your real keys.
APP_ENV=development
DATABASE_PATH=runtime/lingua.db
# Required for production. A private single-workspace access token (32+ characters).
WORKSPACE_TOKEN=
# Optional: without this, local lexical search + quoted excerpts only.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_SEED=true
MAX_UPLOAD_MB=5
